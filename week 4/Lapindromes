import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef {
    public static void main (String[] args) throws java.lang.Exception {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int t = sc.nextInt();
        while (t-- > 0) {
            String s = sc.next();
            int n = s.length();
            
            // First half goes from 0 to (n / 2) - 1
            String left = s.substring(0, n / 2);
            
            // Second half starts after the middle character if n is odd
            String right = s.substring((n + 1) / 2);
            
            // Count character frequencies for left half
            int[] leftFreq = new int[26];
            int[] rightFreq = new int[26];
            
            for (int i = 0; i < left.length(); i++) {
                leftFreq[left.charAt(i) - 'a']++;
                rightFreq[right.charAt(i) - 'a']++;
            }
            
            // Compare frequency arrays
            boolean isLapindrome = true;
            for (int i = 0; i < 26; i++) {
                if (leftFreq[i] != rightFreq[i]) {
                    isLapindrome = false;
                    break;
                }
            }
            
            if (isLapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        sc.close();
    }
}
